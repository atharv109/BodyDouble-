#!/usr/bin/env python3
"""Trusted ISO entrypoint: Python-only bootstrap and twin agent."""
from __future__ import annotations

import argparse
import asyncio
import os
import sys

sys.path.insert(0, "/usr/lib/bd")

from bd_forensics.control_plane import HttpControlPlane  # noqa: E402
from bd_forensics.metadata import configure_boot, load_bootstrap  # noqa: E402
from bd_forensics.tools import execute  # noqa: E402
from bd_forensics.twin import TwinAgent  # noqa: E402
from contracts.models import ToolResult  # noqa: E402


def _tool_fn(call):
    try:
        return execute(call, os.environ.get("BD_MOUNT", "/mnt/disk"))
    except ValueError as exc:
        return ToolResult(job_id=call.job_id, code="", stdout="",
                          stderr=f"refused: {exc}", exit_code=126, duration_ms=0)


async def run_agent(bootstrap: dict[str, str]) -> int:
    cp = HttpControlPlane(bootstrap["control_plane"])
    agent = TwinAgent(
        cp, case_id=bootstrap["case_id"], token=bootstrap["token"],
        vpc_ip=bootstrap["vpc_ip"], tool_fn=_tool_fn,
    )
    seal = await agent.run()
    return 0 if seal.sealed else 1


if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("--configure-boot", action="store_true")
    parser.add_argument("--metadata-url")
    parser.add_argument("--nft-template")
    parser.add_argument("--nft-output")
    parser.add_argument("--bootstrap-file", required=True)
    args = parser.parse_args()
    if args.configure_boot:
        try:
            configure_boot(args.metadata_url, args.nft_template, args.nft_output,
                           args.bootstrap_file)
        except Exception as exc:
            print(f"bootstrap refused: {exc}", file=sys.stderr)
            sys.exit(2)
        sys.exit(0)
    sys.exit(asyncio.run(run_agent(load_bootstrap(args.bootstrap_file))))
