#!/usr/bin/env python3
"""Configure the twin's VPC interface from the validated bootstrap (T4).

Vultr VPC networks have no DHCP: the control plane picks the twin's VPC IP and
hands it over in user_data. boot.sh DHCPs every NIC first; the public NIC gets
a lease, the VPC NIC does not. This assigns vpc_ip/<prefix> to the first NIC
still without IPv4. Values come only from bd_forensics.metadata.load_bootstrap,
which re-validates them; shell code never parses metadata.
"""
import ipaddress
import json
import subprocess
import sys

sys.path.insert(0, "/usr/lib/bd")
from bd_forensics.metadata import load_bootstrap  # noqa: E402


def main(bootstrap_file: str) -> int:
    b = load_bootstrap(bootstrap_file)
    net = ipaddress.IPv4Network(b["vpc_subnet"])
    addrs = json.loads(subprocess.run(["ip", "-j", "-4", "addr"], capture_output=True,
                                      text=True, check=True).stdout or "[]")
    have_v4 = {a["ifname"] for a in addrs if a.get("addr_info")}
    links = json.loads(subprocess.run(["ip", "-j", "link"], capture_output=True,
                                      text=True, check=True).stdout)
    bare = [l["ifname"] for l in links if l["ifname"] != "lo" and l["ifname"] not in have_v4]
    if not bare:
        print("bd-vpc-up: no NIC without IPv4; VPC interface not configured", file=sys.stderr)
        return 1
    ifname = bare[0]  # one VPC per twin
    subprocess.run(["ip", "link", "set", ifname, "up"], check=True)
    subprocess.run(["ip", "addr", "add", f"{b['vpc_ip']}/{net.prefixlen}", "dev", ifname], check=True)
    print(f"bd-vpc-up: {b['vpc_ip']}/{net.prefixlen} on {ifname}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1]))
